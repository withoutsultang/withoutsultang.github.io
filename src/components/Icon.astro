---
interface Props {
  name: 'github' | 'diagonal' | 'right' | 'left' | 'down' | 'workflow' | 'layers' | 'terminal' | 'spark';
}

const { name } = Astro.props;
---
<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === 'github' && <path d="M9 19c-4.3 1.3-4.3-2.2-6-2.7M15 22v-3.3c0-1 .1-1.4-.5-2 3-.3 6.2-1.5 6.2-6.8 0-1.5-.5-2.7-1.4-3.7.2-.4.6-1.8-.2-3.7 0 0-1.2-.4-3.8 1.4a13 13 0 0 0-6.8 0C5.9 2.1 4.7 2.5 4.7 2.5c-.8 1.9-.4 3.3-.2 3.7a5.4 5.4 0 0 0-1.4 3.7c0 5.3 3.2 6.5 6.2 6.8-.5.5-.6 1.1-.6 2V22" />}
  {name === 'diagonal' && <path d="M6 18 18 6M8 6h10v10" />}
  {name === 'right' && <path d="M4 12h15m-6-6 6 6-6 6" />}
  {name === 'left' && <path d="M20 12H5m6-6-6 6 6 6" />}
  {name === 'down' && <path d="M12 4v15m-6-6 6 6 6-6" />}
  {name === 'workflow' && <><rect x="3" y="3" width="6" height="6" rx="1" /><rect x="15" y="15" width="6" height="6" rx="1" /><path d="M9 6h6a3 3 0 0 1 3 3v6M3 15h6m-3-3v6" /></>}
  {name === 'layers' && <path d="m12 3 9 5-9 5-9-5 9-5Zm-9 9 9 5 9-5M3 16l9 5 9-5" />}
  {name === 'terminal' && <><rect x="3" y="4" width="18" height="16" rx="2" /><path d="m7 9 3 3-3 3m6 0h4" /></>}
  {name === 'spark' && <path d="M12 3c.8 5 4 8.2 9 9-5 .8-8.2 4-9 9-.8-5-4-8.2-9-9 5-.8 8.2-4 9-9ZM5 3v4M3 5h4" />}
</svg>
