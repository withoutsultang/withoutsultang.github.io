---
import { github, owner } from '../data/portfolio';
import Icon from './Icon.astro';
---
<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href="/" aria-label={`${owner} 포트폴리오 홈`}>
      <span class="brand-mark" aria-hidden="true">G<span>.</span></span>
      <span>{owner}<small>DEVELOPER PORTFOLIO</small></span>
    </a>
    <nav aria-label="주 메뉴">
      <a href="/#projects">프로젝트</a>
      <a href="/#stack">기술</a>
      <a href="/#background">경험</a>
    </nav>
    <a class="header-github" href={github}><Icon name="github" /> GitHub <span class="header-arrow"><Icon name="diagonal" /></span></a>
  </div>
</header>
