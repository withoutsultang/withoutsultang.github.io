---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---
<Base title="페이지를 찾을 수 없습니다 | 김건우" description="포트폴리오 홈에서 프로젝트를 다시 찾아보세요." noindex>
  <section class="shell not-found">
    <span class="eyebrow">404 · PAGE NOT FOUND</span>
    <h1>페이지를 찾을 수 없습니다.</h1>
    <p>포트폴리오 홈으로 돌아가 프로젝트를 찾아보세요.</p>
    <a class="button button-dark" href="/"><Icon name="left" /> 포트폴리오 홈</a>
  </section>
</Base>
